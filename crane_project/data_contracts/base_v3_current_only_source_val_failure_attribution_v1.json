{
  "protocol": "base_v3_current_only_source_val_failure_attribution_contract_v1",
  "status": "post_gate_explanatory_audit_frozen_before_attribution_output",
  "purpose": "Explain the already failed current-only source-val gate without changing its decision or selecting a new model.",
  "evidence_boundary": "official_source_val_738_existing_predictions_plus_seq11_existing_audit",
  "inputs": {
    "current_only": "existing 738-frame results bound by the failed gate",
